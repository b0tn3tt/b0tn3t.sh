# b0tn3t LFS kernel: merged on top of `make ARCH=i386 tinyconfig`.
# Target is the v86 emulator only: one CPU, PCI virtio devices,
# a 9p root filesystem, a virtio console for the terminal and IPv4 over
# virtio-net (the other end is v86's fetch adapter in the page).

# --- CPU / platform (v86 is a single 686-class CPU) ---
CONFIG_M686=y
CONFIG_X86_TSC=y
CONFIG_NOHIGHMEM=y
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PCI=y
CONFIG_PCI_GOANY=y
CONFIG_PRINTK=y
CONFIG_BUG=n
CONFIG_KERNEL_XZ=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# --- userspace ABI that busybox / musl / micropython need ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_POSIX_TIMERS=y
# musl uses the 32-bit time syscalls whenever the value fits (settimeofday!)
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_FILE_LOCKING=y
CONFIG_SHMEM=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y

# --- console: serial for early boot, virtio console (hvc0) for the shell ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=n
CONFIG_VIRTIO_CONSOLE=y

# --- 9p root over virtio, IPv4 over virtio-net ---
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_INET_DIAG=n
CONFIG_SYN_COOKIES=n
CONFIG_NETFILTER=n
CONFIG_XFRM_USER=n
CONFIG_NET_KEY=n
# the address comes from the command line (ip=...), no DHCP client needed
CONFIG_IP_PNP=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# --- explicitly off: things v86 does not have or we never use ---
CONFIG_MODULES=n
CONFIG_SMP=n
CONFIG_BLOCK=n
CONFIG_VT=n
CONFIG_INPUT=n
CONFIG_SWAP=n
CONFIG_SYSVIPC=n
CONFIG_KALLSYMS=n
CONFIG_SECCOMP=n
CONFIG_IO_URING=n
CONFIG_AIO=n
CONFIG_ELF_CORE=n
CONFIG_COREDUMP=n
CONFIG_WIRELESS=n
CONFIG_ETHERNET=n
CONFIG_WLAN=n
CONFIG_RETPOLINE=n
CONFIG_CPU_MITIGATIONS=n
