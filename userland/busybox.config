# b0tn3t LFS busybox: applied with `make allnoconfig KCONFIG_ALLCONFIG=...`.
# Only what an interactive shell in a browser needs, but with every
# line-editing nicety turned on.
CONFIG_STATIC=y
CONFIG_LFS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=y
CONFIG_FEATURE_COMPRESS_USAGE=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_FEATURE_SH_STANDALONE=n
CONFIG_FEATURE_PREFER_APPLETS=y
CONFIG_FEATURE_DEVPTS=y
CONFIG_FEATURE_UTMP=n
CONFIG_LONG_OPTS=y
CONFIG_FEATURE_HUMAN_READABLE=y
CONFIG_UNICODE_SUPPORT=y
CONFIG_FEATURE_CHECK_UNICODE_IN_ENV=y
CONFIG_SUBST_WCHAR=63
CONFIG_LAST_SUPPORTED_WCHAR=1114111
CONFIG_UNICODE_COMBINING_WCHARS=y
CONFIG_UNICODE_WIDE_WCHARS=y
CONFIG_UNICODE_PRESERVE_BROKEN=y

# line editing: history, Ctrl-R, tab completion, resize, fancy prompt
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=4096
CONFIG_FEATURE_EDITING_HISTORY=2000
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_EDITING_SAVE_ON_EXIT=n
CONFIG_FEATURE_REVERSE_SEARCH=y
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_WINCH=y
CONFIG_FEATURE_EDITING_ASK_TERMINAL=n
CONFIG_FEATURE_NON_POSIX_CP=y
CONFIG_FEATURE_USE_SENDFILE=y
CONFIG_FEATURE_SKIP_ROOTFS=y

# shell
CONFIG_SH_IS_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_BASH_COMPAT=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_ASH_ALIAS=y
