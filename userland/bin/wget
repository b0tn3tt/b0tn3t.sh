#!/bin/sh
# busybox wget, but https:// URLs go out as http://. The machine has no TLS
# and its network ends in the browser: the page fetch()es every request,
# over HTTPS when the page itself is on HTTPS.
for a do
  shift
  case $a in https://*) a=http://${a#https://} ;; esac
  set -- "$@" "$a"
done
# wget's own messages go through as they come (progress bar included);
# when the browser could not fetch the URL, say why
. /usr/share/b0tn3t/cors_hint.sh
log=/tmp/.wget.$$
trap 'rm -f "$log" "$log.rc"' EXIT
{ busybox wget "$@" 2>&1 1>&3 3>&-; echo $? >"$log.rc"; } 3>&1 | tee "$log" >&2
rc=$(cat "$log.rc")
if grep -q "502 Fetch Error" "$log"; then
  for a do case $a in -*) ;; *) url=$a ;; esac; done  # the URL comes last
  cors_hint wget "$url"
fi
exit "$rc"
